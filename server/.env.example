# --- Serveur ---
PORT=4000
# 127.0.0.1 en production (derrière nginx), 0.0.0.0 en local
HOST=0.0.0.0
# URL publique du serveur (utilisée pour les URLs des avatars)
PUBLIC_URL=https://api.lunara.app
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
# Origines autorisées (CORS) séparées par des virgules, * pour tout autoriser en dev
CORS_ORIGINS=*
# Commission de la plateforme sur chaque consultation (0.30 = 30 %)
PLATFORM_COMMISSION=0.30

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lunara
DB_PASSWORD=motdepasse
DB_NAME=lunara

# --- Stripe (cartes Visa/Mastercard du Pérou et du monde, Apple Pay, Google Pay) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Daily.co (visio) ---
DAILY_API_KEY=xxx
# Sous-domaine Daily, ex. "lunara" pour https://lunara.daily.co
DAILY_DOMAIN=lunara

# --- Claude (IA d'interprétation) ---
ANTHROPIC_API_KEY=sk-ant-xxx
# Nombre maximum de demandes IA par utilisateur et par jour
AI_DAILY_LIMIT=5
